{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "allowImportingTsExtensions": false, "esModuleInterop": true,
    "module": "ESNext", "moduleResolution": "bundler", "resolveJsonModule": true,
    "isolatedModules": true, "noEmit": true, "jsx": "react-jsx", "strict": true
  },
  "include": ["src"], "references": [{ "path": "./tsconfig.node.json" }]
}
